# General Configurations
PROJECT_NAME=Reflexion
SECRET_KEY=generate-a-secure-secret-key-for-jwt-tokens

# Database Connection (Neon Postgres url in production, local postgres url in development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reflexion
# Set to true to log all SQL statements (development only)
DB_ECHO=false

# GitHub OAuth App details
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Fernet encryption key for GitHub token storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-encryption-key

# Gemini API credentials
GEMINI_API_KEY=your-gemini-api-key
